# --------------------------------------------------------------------------
# Finetuning CLI — example env file
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# `ft` does NOT auto-load this file — load it into your shell first:
#
#   macOS / Linux (bash, zsh):
#     set -a; source .env; set +a
#
#   Windows (PowerShell):
#     Get-Content .env | ForEach-Object {
#       if ($_ -match '^\s*([^#][^=]+)=(.*)$') {
#         [Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim(), 'Process')
#       }
#     }
#
# Alternative: `direnv` (https://direnv.net) — drop these into `.envrc` instead
# and it loads automatically when you `cd` into the directory.
# --------------------------------------------------------------------------

# Required: API key minted at https://finetuning.ai → Settings → API Keys.
# Format: ft_live_ + 32 random chars (40 chars total).
FINETUNING_API_KEY=ft_live_replace_me_with_real_32_char_suffix_here

# Optional: override the public API base URL. Only set this for staging /
# self-hosted testing. Production default is https://pub.finetuning.ai.
# FINETUNING_BASE_URL=https://pub.finetuning.ai

# Optional: relocate the CLI's config + credentials fallback directory.
# Defaults to os.UserConfigDir()/finetuning/ — i.e.
#   macOS:   ~/Library/Application Support/finetuning/
#   Linux:   ~/.config/finetuning/
#   Windows: %APPDATA%\finetuning\
# Useful when running tests in a sandboxed CI workspace.
# FINETUNING_CONFIG_HOME=./.finetuning-test-home

# Optional: turn on integration tests in `go test ./...`. When unset, network-
# touching tests are skipped so CI stays hermetic.
# FINETUNING_INTEGRATION_TEST=1
